{
  "name": "lndry-backend",
  "version": "1.0.0",
  "description": "Laundry service booking and fulfilment platform — Fastify backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "setup:local": "npm run infra:up && npm run db:migrate && npm run db:seed",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:api": "pm2-runtime start ecosystem.config.cjs --env production",
    "start:worker": "node src/worker.js",
    "start:pm2": "pm2 start ecosystem.config.cjs --env production",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seeds/run.js",
    "seed:stores": "node scripts/seed-store-tabs.js",
    "test": "vitest run && npm run test:contracts",
    "test:contracts": "node --test tests/unit/partner-leads.contract.node.mjs",
    "test:watch": "vitest",
    "test:db": "LNDRY_DB_TESTS=1 vitest run tests/db --no-file-parallelism",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@bull-board/fastify": "^9.10.5",
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@sentry/node": "^10.66.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.7.3",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.70.0",
    "cloudinary": "^2.4.0",
    "csv-parse": "^6.1.0",
    "dayjs": "^1.11.12",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "firebase-admin": "^12.7.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.1",
    "pm2": "^7.0.3",
    "razorpay": "^2.9.2",
    "resend": "^3.4.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.33.4",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.3",
    "twilio": "^5.2.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "autocannon": "^7.15.0",
    "eslint": "^9.8.0",
    "fast-check": "^4.8.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "socket.io-client": "^4.8.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
