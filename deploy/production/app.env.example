NODE_ENV=production
APP_NAME=LNDRY Backend
HOST=0.0.0.0
PORT=3000
API_VERSION=v1

FRONTEND_URL=https://lndry.shotlin.in
ADMIN_URL=https://lndrydashboard.shotlin.in
CORS_ORIGINS=https://lndrydashboard.shotlin.in,https://dashboard.shotlin.in

JWT_ACCESS_SECRET=replace_with_a_64_plus_character_secret
JWT_REFRESH_SECRET=replace_with_a_different_64_plus_character_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=365d
COOKIE_SECRET=replace_with_a_32_plus_character_secret

DB_NAME=lndry_db
DB_USER=lndry_user
DB_PASSWORD=replace_with_a_strong_database_password
DB_POOL_MIN=5
DB_POOL_MAX=30
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_DELAY=1000
DB_SSL=false
# Path to a CA bundle to trust when DB_SSL=true and Postgres uses a
# private/self-signed cert. Leave unset to use Node's built-in trusted CA
# store. Certificate verification is always on when DB_SSL=true.
DB_SSL_CA_PATH=

REDIS_PASSWORD=replace_with_a_strong_redis_password
REDIS_DB=0
REDIS_TTL_DEFAULT=600

ALLOW_DEMO_OTP=false
DEMO_OTP_PHONE=9999999999
DEMO_OTP_CODE=123456
ALLOW_ALL_PINCODES=false
ALLOW_DEMO_DELIVERY_ACTIONS=false
SMS_PROVIDER=2factor
TWO_FACTOR_API_KEY=replace_with_2factor_api_key
TWO_FACTOR_TEMPLATE=LndryAppOTP

RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=lndry-app

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
OTP_RATE_LIMIT_MAX=30
OTP_RATE_LIMIT_WINDOW=300000

MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

LOG_LEVEL=info
LOG_PRETTY=false
ENABLE_SWAGGER=false
# Optional — error tracking stays fully disabled (no-op) until this is set.
SENTRY_DSN=

DELIVERY_RADIUS_KM=10
EXPRESS_DELIVERY_MINUTES=30
PLATFORM_FEE=5
FREE_DELIVERY_ABOVE=499
DELIVERY_FEE=25

BULL_REDIS_PASSWORD=replace_with_a_strong_redis_password
BULL_CONCURRENCY=5

# ============================================
# BOOT-TIME GUARDS
# ============================================
# Both currently FAIL to boot (process.exit(1)) if flipped to true against
# this codebase as-is — this is a deliberate, verified default, not an
# oversight. See docs/ARCHITECTURE.md / the backend README for the tracked
# backlog items that must land before either can be safely enabled:
#   - STRICT_PERMISSION_AUDIT: 168 of 194 protected routes are currently
#     missing a `requiredPermission` declaration.
#   - STRICT_SESSION_VERSION_CHECK: the OTP-based customer/rider login flow
#     does not yet mint a `session_version` claim (only HQ/dashboard
#     email+password logins do).
# Do not flip either without first re-running the boot-time audit locally
# and confirming zero violations.
STRICT_PERMISSION_AUDIT=false
STRICT_SESSION_VERSION_CHECK=false

# =======================================================================
# SECURITY & SCALE (added in the 2026-10 hardening pass)
# =======================================================================
# Which proxies may set X-Forwarded-For. Default trusts only private/loopback
# addresses (nginx, cloudflared, a VPC load balancer), so a client can never
# forge its IP to dodge rate limits. Use a hop count ("2") or "true" only if you
# know your topology.
TRUST_PROXY=loopback,linklocal,uniquelocal

# Blanket per-IP and per-login-token request caps (per window). Per-route limits
# (login, OTP, payments ...) still apply on top.
RATE_LIMIT_GLOBAL_IP_MAX=1800
RATE_LIMIT_GLOBAL_TOKEN_MAX=900
RATE_LIMIT_GLOBAL_WINDOW=60000

# PostgreSQL safety nets (milliseconds)
DB_STATEMENT_TIMEOUT_MS=60000
DB_IDLE_IN_TX_TIMEOUT_MS=60000

# EMERGENCY ROLLBACK ONLY: restores "shop employee token == platform ADMIN".
# Leave false. See src/utils/actor-role.js.
LEGACY_SHOP_STAFF_ADMIN_ROLE=false

# Production refuses to boot with TEST_BYPASS_OTP_PHONES="*", ALLOW_DEMO_OTP,
# ALLOW_MOCK_PAYMENT, ALLOW_ALL_PINCODES, ALLOW_DEMO_DELIVERY_ACTIONS,
# ALLOW_AUTO_APPROVE_VENDOR, RATE_LIMIT_ENABLED=false, identical or placeholder
# JWT secrets (see findProductionConfigProblems in src/config/env.js).
TEST_BYPASS_OTP_PHONES=

# Authenticator-app (TOTP) two-factor for the admin dashboard (login code + step-up before
# high-risk actions). OFF by default. SMS OTP via 2factor.in is separate and unaffected.
ADMIN_2FA_ENABLED=false
